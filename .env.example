# Copy to .env. Every value here is fake — never commit a real credential.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# docker compose provides these hosts; change only if running services yourself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flightalerts?schema=public
DB_POOL_MAX=5
REDIS_HOST=localhost
REDIS_PORT=6379

# fixture replays captured real provider payloads: offline, free, deterministic.
# Switch to fr24 only with a key; the sandbox key is free and consumes no credits.
FLIGHT_PROVIDER=fixture
FR24_API_KEY=
FR24_BASE_URL=https://fr24api.flightradar24.com
FR24_MAX_IDS_PER_QUERY=10

PROVIDER_TIMEOUT_MS=8000

# One value, used by the service and by the demo script. Anything else means
# the script signs with one secret and the service verifies with another.
# Generate a real one for anything but local: openssl rand -hex 32
INGEST_HMAC_SECRET=local-development-secret-not-for-production

# Only needed by a separately hosted frontend. Empty disables CORS entirely.
CORS_ORIGINS=http://localhost:3001
